{
  "name": "qqaichatbot",
  "version": "0.1.3",
  "private": true,
  "description": "QQ AI 聊天机器人多连接后台客户端",
  "main": "electron/main.cjs",
  "scripts": {
    "build:server": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "dev": "tsx watch src/main.ts",
    "start": "node --experimental-sqlite dist/main.js",
    "verify:serve": "node scripts/verify-web-serve.cjs",
    "smoke": "node scripts/smoke-pipeline.cjs && node scripts/smoke-c2c.cjs && node scripts/smoke-config.cjs && node scripts/smoke-runtime.cjs",
    "e2e": "node scripts/e2e-check.cjs",
    "verify": "npm run build && npm run verify:serve",
    "electron": "electron electron/main.cjs",
    "pack": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "antd": "^5.22.2",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "fastify": "^5.2.0",
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "undici": "^7.30.1",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
